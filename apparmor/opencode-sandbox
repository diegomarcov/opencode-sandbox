#include <tunables/global>

@{OPENCODE_HOME}=/home/opencode
@{WORKDIR}=/work

profile opencode-sandbox flags=(attach_disconnected, mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  # Binary execution.
  /usr/local/bin/opencode rix,
  /usr/bin/opencode rix,
  /usr/bin/** rix,
  /bin/** rix,
  /lib/** rix,
  /lib64/** rix,
  /usr/lib/** rix,
  /usr/local/lib/** rix,

  # TLS/cert and data reads.
  /usr/share/** r,

  # Writable work and state directories.
  @{WORKDIR}/ rw,
  @{WORKDIR}/** rwk,
  @{OPENCODE_HOME}/ rw,
  @{OPENCODE_HOME}/** rwk,

  # Runtime scratch areas.
  /tmp/ rwk,
  /tmp/** rwk,
  /run/ rwk,
  /run/** rwk,

  # Read access needed by tools.
  /proc/** r,
  /sys/** r,
  /etc/** r,

  # Device access for normal process IO.
  /dev/null rw,
  /dev/random r,
  /dev/urandom r,
  /dev/tty rw,
  /dev/pts/[0-9]* rw,

  # Keep potentially risky operations unavailable.
  deny /proc/*/mem rw,
  deny /proc/kcore rw,
  deny /proc/sys/kernel/core_pattern rw,
  deny /sys/** w,
  deny mount,
  deny ptrace,
}
